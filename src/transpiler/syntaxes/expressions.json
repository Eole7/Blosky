{
  "PlayerHealth": {
    "syntax": "§{player}'s health",
    "java_syntax": "§{player}.getHealth()",
    "return_type": "double",
    "arguments": {
      "§{player}": {
        "required_type": "Player",
        "nullable": "false"
      }
    }
  },
  "PlayerName": {
    "syntax": "§{player}'s name",
    "java_syntax": "§{player}.getName()",
    "return_type": "String",
    "arguments": {
      "§{player}": {
        "required_type": "Player",
        "nullable": "false"
      }
    }
  },
  "OnlinePlayers": {
    "syntax": "all online players",
    "java_syntax": "Bukkit.getOnlinePlayers()",
    "return_type": "Collection"
  },
  "EventPlayer": {
    "syntax": "event player",
    "context_dependent": "Event",
    "java_syntax": {
      "default": "event.getPlayer()",
      "exceptions": {
        "InventoryClickEvent": "event.getWhoClicked()",
        "BlockBreakEvent": "event.getPlayer()",
        "BlockPlaceEvent": "event.getPlayer()",
        "EntityDeathEvent": "null",
        "EntitySpawnEvent": "null",
        "EntityTameEvent": "((EntityTameEvent) event).getOwner() instanceof Player ? (Player) ((EntityTameEvent) event).getOwner() : null",
        "EntityTargetEvent": "((EntityTargetEvent) event).getTarget() instanceof Player ? (Player) ((EntityTargetEvent) event).getTarget() : null",
        "EntityExplodeEvent": "null",
        "CreatureSpawnEvent": "null",
        "VehicleEnterEvent": "event.getVehicle() instanceof Player ? (Player) event.getVehicle() : null",
        "VehicleExitEvent": "event.getVehicle() instanceof Player ? (Player) event.getVehicle() : null",
        "WeatherChangeEvent": "null",
        "WorldLoadEvent": "null",
        "WorldUnloadEvent": "null",
        "ServerListPingEvent": "null"
      }
    },
    "return_type": "Player"
  }
}